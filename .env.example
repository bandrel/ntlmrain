# Copy to .env and edit. docker-compose.yml reads this file for every server
# setting, so the compose file itself needs no changes for a normal deployment.
#
# Only the "Table data" section below is required; everything else has a
# working default. Leave an optional setting COMMENTED OUT to accept its
# default -- do not set it to an empty value. The server parses its config
# with clap, which treats an empty string as a value that was supplied, so
# NTLMRAIN_SERVER_READ_WORKERS= is a parse error rather than "unset".

# --- Table data (required) ---------------------------------------------------
# The host directory CONTAINING your GRTB shards and the .gidx index. Not the
# table itself -- there is no single table file to point at. It is bind-mounted
# read-only at /data inside the container.
#
# The shards and the .gidx must be readable by uid 1000, the unprivileged user
# the container drops to. A root-owned 0600 table mounts cleanly and then fails
# at open time, which reads as a config error but is a permissions one.
TABLES_DIR=/srv/tables

# GRTB shard base path, as seen INSIDE the container, so it starts with /data.
#
# This is a filename PREFIX, not a directory and not a file that exists on
# disk. The server appends a shard suffix to it, so a base of
# /data/mytable is opened as /data/mytable.0000.grtb, .0001.grtb, and so on.
# Take the prefix your shards share and drop the ".NNNN.grtb" tail.
#
# A "#" is part of the value here: this file only starts a comment at a "#"
# that follows whitespace, so a table name containing one needs no quoting or
# escaping. Quote only if the name contains a space.
NTLMRAIN_SERVER_DATA_BASE=/data/netntlmv1_byte#7-7_0_881689x134217668

# GIDX index file, also as seen inside the container. Unlike the base path
# above this is a real file: the shard prefix plus ".gidx".
NTLMRAIN_SERVER_INDEX=/data/netntlmv1_byte#7-7_0_881689x134217668.gidx

# --- Server tuning (optional) ------------------------------------------------
# Concurrent table-read workers. Default: system CPU count.
# NTLMRAIN_SERVER_READ_WORKERS=4

# Read the GIDX index into memory at startup instead of faulting it in on
# demand. Trades a slower start for no first-lookup latency spike.
# NTLMRAIN_SERVER_PRELOAD_INDEX=true

# Lock the index into memory (mlock) so it cannot be swapped out. Needs the
# container to be allowed to exceed its memlock limit.
# NTLMRAIN_SERVER_LOCK_INDEX=true

# Concurrent lookup slots. Default: 2.
# NTLMRAIN_SERVER_LOOKUP_SLOTS=4

# Directory of static web assets served at /. The image already builds the
# browser UI and bakes this in, so the service comes up with a working UI and
# needs nothing here. Override only to serve a different bundle, e.g. a
# bind-mounted web/dist you are iterating on.
# NTLMRAIN_SERVER_STATIC_DIR=/usr/share/ntlmrain/web

# --- HTTP Basic auth (optional) ----------------------------------------------
# Set the user plus EXACTLY ONE password source. With auth configured, the
# /api/v1/submissions* routes require credentials; /health/*, /openapi.json
# and /docs stay unauthenticated.
#
# Setting the user without a password source is a startup error, as is setting
# both password sources at once.
#
# NTLMRAIN_SERVER_AUTH_USER=admin
#
# Either the password inline (env only, never a CLI flag, so it does not land
# in the process list) ...
# NTLMRAIN_SERVER_AUTH_PASSWORD=correct-horse-battery-staple
#
# ... or a file to read it from, which keeps it out of this file entirely.
# Mount the file into the container yourself.
# NTLMRAIN_SERVER_AUTH_PASSWORD_FILE=/run/secrets/ntlmrain_password

# --- TLS ---------------------------------------------------------------------
# Consumed by the cert-init and caddy services, not by the server.

# --- Self-signed (default) ---
# Equivalent to:
#
#   SITE_ADDRESS=:443
#   TLS_ARGS=/certs/tls.crt /certs/tls.key
#
# ":443" answers on any hostname or address, and cert-init generates the
# certificate before Caddy starts. The browser warns once because the
# certificate is self-signed; clicking through grants a secure context, which
# is all WebGPU needs.
#
# Browsers match on subjectAltName, so list every address you actually browse
# to. localhost and 127.0.0.1 are always included. Changing this after the
# first run has no effect until you delete the "certs" volume, since
# cert-init deliberately does not overwrite an existing certificate:
#
#   docker compose down && docker volume rm <project>_certs && docker compose up -d
#
# CERT_HOSTS=10.0.0.5,ntlmrain.lan

# --- Let's Encrypt (optional) ---
# Uncomment both. SITE_ADDRESS must be a domain that resolves to this host,
# and port 80 must be reachable from the internet for the HTTP-01 challenge.
# Passing an email to Caddy's `tls` directive is what switches it from the
# generated files to ACME.
#
# SITE_ADDRESS=ntlmrain.example.com
# TLS_ARGS=you@example.com
