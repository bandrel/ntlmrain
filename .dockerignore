# Git and version control
.git
.gitignore

# Build artifacts and cache
target/
*.pdb

# Rust-specific
Cargo.lock.local
rust-toolchain.toml.local

# Test artifacts
.superpowers/
.pytest_cache/
*.grtb
*.gidx

# State and data directories (test artifacts)
state/
*.db
*.db-journal

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# CI/CD and automation
.github/
.gitlab-ci.yml

# Task artifacts (not needed in image)
.docker-task/

# Web build inputs/outputs that the image regenerates itself.
# These must be excluded, not merely ignored: if a stale host-built
# crypto-wasm/pkg or web/dist were copied into the context, it would be
# layered over the freshly built one and shipped instead of it.
node_modules/
web/node_modules/
web/dist/
web/public/shaders/
crypto-wasm/pkg/

# Local deployment secrets/config; never belongs in an image layer.
.env
